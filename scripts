#!/usr/bin/env bash
# ==============================================================================
# Script:      scripts
# Category:    manager
# Description: Unified manager for the nada.mu personal utilities ecosystem.
# Target:      Linux / macOS
# Usage:       scripts [command] [options]
# ==============================================================================
set -euo pipefail

VERSION="1.1.0"
GITHUB_RAW="https://raw.githubusercontent.com/DanyaNADAMU/Scripts/main"
GITHUB_RAW_RESOLVED=""
COMMIT_SHA=""

# Ensure standard user and system binary paths are present in PATH
for _p in /usr/local/bin /usr/local/sbin "$HOME/.local/bin"; do
    if [ -d "$_p" ] && [[ ":$PATH:" != *":$_p:"* ]]; then
        export PATH="$_p:$PATH"
    fi
done

# Determine execution context (local repository vs remote/standalone)
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF_PATH")" 2>/dev/null && pwd || echo "")"

if [ -n "$REPO_DIR" ] && [ -f "$REPO_DIR/manifest.txt" ]; then
    IS_LOCAL_REPO=true
    SOURCE_DIR="$REPO_DIR"
else
    IS_LOCAL_REPO=false
    REPO_DIR=""
    SOURCE_DIR=""
fi

TMP_SOURCE_DIR=""
CLEANUP_PATHS=()

register_tmp() {
    CLEANUP_PATHS+=("$1")
}

cleanup_source() {
    if [ -n "$TMP_SOURCE_DIR" ] && [ -d "$TMP_SOURCE_DIR" ]; then
        rm -rf "$TMP_SOURCE_DIR"
        TMP_SOURCE_DIR=""
        if [ "$IS_LOCAL_REPO" = false ]; then
            SOURCE_DIR=""
        fi
    fi
}

cleanup_all() {
    cleanup_source
    for p in "${CLEANUP_PATHS[@]}"; do
        if [ -d "$p" ]; then
            rm -rf "$p" 2>/dev/null || true
        elif [ -f "$p" ]; then
            rm -f "$p" 2>/dev/null || true
        fi
    done
    CLEANUP_PATHS=()
}
trap cleanup_all EXIT INT TERM

get_github_raw_url() {
    if [ -n "$GITHUB_RAW_RESOLVED" ]; then
        echo "$GITHUB_RAW_RESOLVED"
        return 0
    fi
    if [ "$IS_LOCAL_REPO" = true ]; then
        GITHUB_RAW_RESOLVED="$GITHUB_RAW"
        echo "$GITHUB_RAW_RESOLVED"
        return 0
    fi
    if [ -z "$COMMIT_SHA" ]; then
        COMMIT_SHA="$(curl -fsSL --connect-timeout 2 --max-time 4 "https://api.github.com/repos/DanyaNADAMU/Scripts/commits/main" 2>/dev/null | grep '"sha"' | head -n 1 | cut -d'"' -f4 || echo "")"
    fi
    if [ -n "$COMMIT_SHA" ]; then
        GITHUB_RAW_RESOLVED="https://raw.githubusercontent.com/DanyaNADAMU/Scripts/$COMMIT_SHA"
    else
        GITHUB_RAW_RESOLVED="$GITHUB_RAW"
    fi
    echo "$GITHUB_RAW_RESOLVED"
}

acquire_source() {
    if [ "$IS_LOCAL_REPO" = true ]; then
        SOURCE_DIR="$REPO_DIR"
        return 0
    fi

    if [ -n "$SOURCE_DIR" ] && [ -d "$SOURCE_DIR" ]; then
        return 0
    fi

    TMP_SOURCE_DIR="$(mktemp -d -t scripts-upstream.XXXXXX)"
    register_tmp "$TMP_SOURCE_DIR"

    local tar_url="https://github.com/DanyaNADAMU/Scripts/archive/refs/heads/main.tar.gz"
    local dl_ok=false

    if command -v tar &>/dev/null; then
        if curl -fsSL --connect-timeout 5 --max-time 30 "$tar_url" 2>/dev/null | tar -xz --strip-components=1 -C "$TMP_SOURCE_DIR" 2>/dev/null; then
            if [ -f "$TMP_SOURCE_DIR/manifest.txt" ]; then
                dl_ok=true
            fi
        fi
    fi

    if [ "$dl_ok" = true ]; then
        SOURCE_DIR="$TMP_SOURCE_DIR"
    else
        log_warn "Snapshot archive download failed; falling back to direct downloads."
        SOURCE_DIR=""
    fi
}

# ------------------------------------------------------------------------------
# Helpers: I/O and Paths
# ------------------------------------------------------------------------------
log_info()  { echo -e "  \033[1;34m[i]\033[0m $*"; }
log_ok()    { echo -e "  \033[1;32m[✓]\033[0m $*"; }
log_warn()  { echo -e "  \033[1;33m[!]\033[0m $*"; }
log_err()   { echo -e "  \033[1;31m[✗]\033[0m $*" >&2; }
log_head()  { echo -e "\n\033[1;36m==>\033[0m \033[1m$*\033[0m"; }

read_input() {
    local prompt="$1"
    local default="$2"
    local var_name="$3"
    local reply=""

    if [ -t 0 ]; then
        read -r -p "$prompt [$default]: " reply || true
    elif [ -c /dev/tty ]; then
        read -r -p "$prompt [$default]: " reply < /dev/tty 2>/dev/tty || true
    else
        reply=""
    fi
    reply="${reply:-$default}"
    eval "$var_name=\"$reply\""
}

get_sha256() {
    local file="$1"
    if [ -f "$file" ]; then
        sha256sum "$file" 2>/dev/null | awk '{print $1}' || echo ""
    else
        echo ""
    fi
}

# ------------------------------------------------------------------------------
# Dependency Checking & Auto-Installation
# ------------------------------------------------------------------------------
check_dependencies() {
    local cat="$1"
    local auto_yes="$2"
    local scope="${3:-user}"

    if [ "$cat" = "all" ] || [ "$cat" = "media" ] || [ "$cat" = "desktop" ] || [ "$cat" = "server" ]; then
        # Ensure standard paths are active in PATH
        for _p in /usr/local/bin /usr/local/sbin /usr/bin "$HOME/.local/bin"; do
            if [ -d "$_p" ] && [[ ":$PATH:" != *":$_p:"* ]]; then
                export PATH="$_p:$PATH"
            fi
        done

        # If running via sudo, check the original user's local bin as well
        if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
            local user_home
            user_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
            if [ -n "$user_home" ] && [ -d "$user_home/.local/bin" ] && [[ ":$PATH:" != *":$user_home/.local/bin:"* ]]; then
                export PATH="$user_home/.local/bin:$PATH"
            fi
        fi

        # Check for uv binary in known candidate locations if not yet in PATH
        if ! command -v uv &>/dev/null; then
            for _cand in /usr/local/bin/uv /usr/bin/uv "$HOME/.local/bin/uv"; do
                if [ -x "$_cand" ]; then
                    export PATH="$(dirname "$_cand"):$PATH"
                    break
                fi
            done
        fi

        # In system scope or when running as root, ensure /usr/local/bin/uv is symlinked to /usr/bin
        # to permanently resolve the Debian/Ubuntu/Kali sudo secure_path restriction
        if [ -x "/usr/local/bin/uv" ] && ([ "$scope" = "system" ] || [ "$EUID" -eq 0 ]); then
            if [ ! -e "/usr/bin/uv" ] || [ -L "/usr/bin/uv" ]; then
                ln -sf /usr/local/bin/uv /usr/bin/uv 2>/dev/null || true
            fi
            if [ -x "/usr/local/bin/uvx" ] && ([ ! -e "/usr/bin/uvx" ] || [ -L "/usr/bin/uvx" ]); then
                ln -sf /usr/local/bin/uvx /usr/bin/uvx 2>/dev/null || true
            fi
        fi

        if ! command -v uv &>/dev/null; then
            local installed_via_pacman=false
            if command -v pacman &>/dev/null; then
                log_info "Detected pacman. Attempting native package installation of 'uv'..."
                if [ "$EUID" -eq 0 ]; then
                    pacman -S --needed --noconfirm uv 2>/dev/null || true
                else
                    if [ "$auto_yes" = true ] || [ -t 0 ]; then
                        sudo pacman -S --needed --noconfirm uv 2>/dev/null || true
                    fi
                fi
                if command -v uv &>/dev/null; then
                    installed_via_pacman=true
                    log_ok "'uv' installed natively via pacman."
                fi
            fi

            if [ "$installed_via_pacman" = false ]; then
                log_info "Dependency 'uv' is missing (required for Python utilities). Installing automatically..."
                local target_dir="$HOME/.local/bin"
                if [ "$scope" = "system" ] || [ "$EUID" -eq 0 ]; then
                    target_dir="/usr/local/bin"
                fi
                if curl -LsSf --connect-timeout 5 --max-time 30 https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$target_dir" sh; then
                    export PATH="$target_dir:$PATH"
                    if [ -x "$target_dir/uv" ] && [ "$target_dir" = "/usr/local/bin" ] && ([ "$scope" = "system" ] || [ "$EUID" -eq 0 ]); then
                        ln -sf /usr/local/bin/uv /usr/bin/uv 2>/dev/null || true
                        ln -sf /usr/local/bin/uvx /usr/bin/uvx 2>/dev/null || true
                    fi
                    if command -v uv &>/dev/null; then
                        log_ok "'uv' installed successfully into $target_dir."
                    fi
                else
                    log_warn "uv auto-install failed. Python utilities may require uv to run."
                fi
            fi
        fi
    fi
}


# ------------------------------------------------------------------------------
# Scope & Path Configuration
# ------------------------------------------------------------------------------
set_scope_paths() {
    local scope="$1"
    if [ "$scope" = "system" ]; then
        BIN_DIR="/usr/local/bin"
        MAN_DIR="/usr/local/share/man/man1"
        BASH_COMP_DIR="/usr/share/bash-completion/completions"
        ZSH_COMP_DIR="/usr/local/share/zsh/site-functions"
        FISH_COMP_DIR="/usr/share/fish/vendor_completions.d"
        STATE_DIR="/var/lib/scripts"
        NEED_SUDO=true
    else
        local target_home="$HOME"
        if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
            target_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
        fi
        BIN_DIR="${target_home}/.local/bin"
        MAN_DIR="${target_home}/.local/share/man/man1"
        BASH_COMP_DIR="${target_home}/.local/share/bash-completion/completions"
        ZSH_COMP_DIR="${target_home}/.local/share/zsh/site-functions"
        FISH_COMP_DIR="${target_home}/.config/fish/completions"
        STATE_DIR="${target_home}/.local/state/scripts"
        NEED_SUDO=false
    fi
}

detect_and_resolve_scope() {
    local requested_scope="$1"
    local auto_yes="$2"

    if [ -n "$requested_scope" ]; then
        echo "$requested_scope"
        return 0
    fi

    # Determine real user home directory even if running with sudo
    local effective_user_home="$HOME"
    if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        effective_user_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
    fi

    local has_sys=false
    local has_usr=false

    if [ -f "/usr/local/bin/scripts" ] || [ -f "/var/lib/scripts/manifest.txt" ]; then
        has_sys=true
    fi

    if [ -f "$effective_user_home/.local/bin/scripts" ] || [ -f "$effective_user_home/.local/state/scripts/manifest.txt" ]; then
        has_usr=true
    fi

    # Mismatch resolution
    if [ "$has_sys" = true ] && [ "$has_usr" = false ]; then
        # Existing installation is System
        if [ "$EUID" -ne 0 ]; then
            # Mismatch: System install exists, but running without root
            if [ "$auto_yes" = true ] || ([ ! -t 0 ] && [ ! -c /dev/tty ]); then
                log_err "Existing system installation detected in /usr/local/bin, but running without root privileges." >&2
                log_info "Please run with sudo: 'sudo scripts sync', or specify '--scope user'." >&2
                return 1
            fi

            log_warn "Existing system installation detected in /usr/local/bin, but running without root privileges." >&2
            echo -e "  \033[1m[1]\033[0m Escalate with sudo to update system installation (/usr/local/bin) [default]" >&2
            echo -e "  \033[1m[2]\033[0m Install local copy in user profile ($effective_user_home/.local/bin)" >&2
            echo -e "  \033[1m[3]\033[0m Cancel" >&2
            local choice="1"
            read_input "Select action" "1" choice
            case "$choice" in
                1)
                    sudo -v >&2 || { log_err "Sudo authentication failed." >&2; return 1; }
                    echo "system"
                    return 0
                    ;;
                2)
                    echo "user"
                    return 0
                    ;;
                *)
                    echo "Aborted." >&2
                    return 2
                    ;;
            esac
        else
            echo "system"
            return 0
        fi
    elif [ "$has_usr" = true ] && [ "$has_sys" = false ]; then
        # Existing installation is User
        if [ "$EUID" -eq 0 ]; then
            # Mismatch: User install exists, but running with root/sudo
            if [ "$auto_yes" = true ] || ([ ! -t 0 ] && [ ! -c /dev/tty ]); then
                echo "user"
                return 0
            fi

            log_warn "Existing user installation detected in $effective_user_home/.local/bin, but running with root privileges." >&2
            echo -e "  \033[1m[1]\033[0m Update user installation in $effective_user_home/.local/bin [default]" >&2
            echo -e "  \033[1m[2]\033[0m Install new system-wide copy in /usr/local/bin" >&2
            echo -e "  \033[1m[3]\033[0m Cancel" >&2
            local choice="1"
            read_input "Select action" "1" choice
            case "$choice" in
                1)
                    echo "user"
                    return 0
                    ;;
                2)
                    echo "system"
                    return 0
                    ;;
                *)
                    echo "Aborted." >&2
                    return 2
                    ;;
            esac
        else
            echo "user"
            return 0
        fi
    else
        # Neither exists, or both exist: default based on EUID
        if [ "$EUID" -eq 0 ]; then
            echo "system"
        else
            echo "user"
        fi
        return 0
    fi
}

ensure_write_access() {
    local dir="$1"
    if [ ! -d "$dir" ]; then
        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo mkdir -p "$dir"
        else
            mkdir -p "$dir"
        fi
    fi
}

safe_copy_or_link() {
    local src="$1"
    local dst="$2"
    local mode="$3" # "link" or "copy"
    local as_root="${4:-false}"

    local cmd_prefix=""
    if [ "$as_root" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    if [ "$mode" = "link" ]; then
        $cmd_prefix ln -sf "$src" "$dst"
    else
        $cmd_prefix cp --remove-destination -f "$src" "$dst" 2>/dev/null || $cmd_prefix cp -f "$src" "$dst"
    fi
    $cmd_prefix chmod 755 "$dst" 2>/dev/null || true

}

fetch_file() {
    local rel_path="$1"
    local dest_file="$2"

    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$rel_path" ]; then
        cp -f "$SOURCE_DIR/$rel_path" "$dest_file"
    else
        local base_raw
        base_raw="$(get_github_raw_url)"
        curl -fsSL --connect-timeout 4 --max-time 15 "$base_raw/$rel_path" -o "$dest_file"
    fi
}

install_asset() {
    local rel_src="$1"
    local target_file="$2"
    local perm="${3:-644}"

    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    if [ -n "$SOURCE_DIR" ]; then
        if [ -f "$SOURCE_DIR/$rel_src" ]; then
            $cmd_prefix cp -f "$SOURCE_DIR/$rel_src" "$target_file"
            $cmd_prefix chmod "$perm" "$target_file" 2>/dev/null || true
        fi
    else
        local tmp_f
        tmp_f="$(mktemp -t scripts-asset.XXXXXX)"
        register_tmp "$tmp_f"
        local base_raw
        base_raw="$(get_github_raw_url)"
        if curl -fsSL --connect-timeout 4 --max-time 15 "$base_raw/$rel_src" -o "$tmp_f" 2>/dev/null && [ -s "$tmp_f" ]; then
            $cmd_prefix cp -f "$tmp_f" "$target_file"
            $cmd_prefix chmod "$perm" "$target_file" 2>/dev/null || true
        fi
        rm -f "$tmp_f"
    fi
}

install_man_and_completions() {
    local name="$1"
    install_asset "docs/man/man1/${name}.1" "$MAN_DIR/${name}.1" "644"
    install_asset "completions/bash/${name}" "$BASH_COMP_DIR/${name}" "644"
    install_asset "completions/zsh/_${name}" "$ZSH_COMP_DIR/_${name}" "644"
    install_asset "completions/fish/${name}.fish" "$FISH_COMP_DIR/${name}.fish" "644"
}

uninstall_man_and_completions() {
    local name="$1"
    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi
    $cmd_prefix rm -f "$MAN_DIR/${name}.1" "$BASH_COMP_DIR/${name}" "$ZSH_COMP_DIR/_${name}" "$FISH_COMP_DIR/${name}.fish"
    # Additional cleanup in common system paths to ensure zero remnants
    if [ "$NEED_SUDO" = true ] || [ "$EUID" -eq 0 ]; then
        $cmd_prefix rm -f "/usr/share/man/man1/${name}.1" "/usr/local/share/man/man1/${name}.1" \
                          "/usr/local/share/bash-completion/completions/${name}" "/usr/share/bash-completion/completions/${name}" \
                          "/etc/bash_completion.d/${name}" \
                          "/usr/local/share/zsh/site-functions/_${name}" "/usr/share/zsh/site-functions/_${name}" \
                          "/usr/share/fish/vendor_completions.d/${name}.fish" "/usr/local/share/fish/vendor_completions.d/${name}.fish" 2>/dev/null || true
    fi
}

get_target_home() {
    local target_home="$HOME"
    if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        target_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
    fi
    echo "$target_home"
}

# ------------------------------------------------------------------------------
# Auto-Update Hook Management
# ------------------------------------------------------------------------------

# --- 1. APT Hook ---
install_apt_hook() {
    if [ -d "/etc/apt/apt.conf.d" ]; then
        local target="/etc/apt/apt.conf.d/99scripts"
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
        fi
        if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/hooks/apt/99scripts" ]; then
            $cmd_prefix cp -f "$SOURCE_DIR/hooks/apt/99scripts" "$target"
        else
            local tmp_hook
            tmp_hook="$(mktemp -t scripts-hook.XXXXXX)"
            register_tmp "$tmp_hook"
            local base_raw
            base_raw="$(get_github_raw_url)"
            if curl -fsSL --connect-timeout 4 --max-time 15 "$base_raw/hooks/apt/99scripts" -o "$tmp_hook" 2>/dev/null && [ -s "$tmp_hook" ]; then
                $cmd_prefix cp -f "$tmp_hook" "$target"
            else
                $cmd_prefix tee "$target" >/dev/null << 'EOF'
// Automated update hook for nada.mu personal utilities
APT::Update::Post-Invoke { "if [ -x /usr/local/bin/scripts ]; then ( /usr/local/bin/scripts autoupdate apt >/dev/null 2>&1 & ); fi"; };
EOF
            fi
            rm -f "$tmp_hook"
        fi
        $cmd_prefix chmod 644 "$target" 2>/dev/null || true
    fi
}

uninstall_apt_hook() {
    if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
        fi
        $cmd_prefix rm -f "/etc/apt/apt.conf.d/99scripts"
    fi
}

# --- 2. Pacman Hook ---
mask_pacman_hook() {
    local target_dir="/etc/pacman.d/hooks"
    local target="$target_dir/99scripts.hook"
    local cmd_prefix=""
    if [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi
    $cmd_prefix mkdir -p "$target_dir"
    $cmd_prefix ln -sf /dev/null "$target"
}

install_pacman_hook() {
    local target_dir="/etc/pacman.d/hooks"
    local target="$target_dir/99scripts.hook"
    local cmd_prefix=""
    if [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi
    $cmd_prefix mkdir -p "$target_dir"
    # Unmask if currently pointing to /dev/null
    if [ -L "$target" ] && [ "$(readlink "$target")" = "/dev/null" ]; then
        $cmd_prefix rm -f "$target"
    fi
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/hooks/pacman/99scripts.hook" ]; then
        $cmd_prefix cp -f "$SOURCE_DIR/hooks/pacman/99scripts.hook" "$target"
    else
        local tmp_hook
        tmp_hook="$(mktemp -t scripts-pacman.XXXXXX)"
        register_tmp "$tmp_hook"
        local base_raw
        base_raw="$(get_github_raw_url)"
        if curl -fsSL --connect-timeout 4 --max-time 15 "$base_raw/hooks/pacman/99scripts.hook" -o "$tmp_hook" 2>/dev/null && [ -s "$tmp_hook" ]; then
            $cmd_prefix cp -f "$tmp_hook" "$target"
        else
            $cmd_prefix tee "$target" >/dev/null << 'EOF'
[Trigger]
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Checking updates for nada.mu scripts ecosystem...
When = PostTransaction
Exec = /usr/bin/bash -c "if [ -x /usr/local/bin/scripts ]; then ( /usr/local/bin/scripts autoupdate pacman >/dev/null 2>&1 & ); elif [ -x /usr/bin/scripts ]; then ( /usr/bin/scripts autoupdate pacman >/dev/null 2>&1 & ); fi"
EOF
        fi
        rm -f "$tmp_hook"
    fi
    $cmd_prefix chmod 644 "$target" 2>/dev/null || true
}

uninstall_pacman_hook() {
    local target="/etc/pacman.d/hooks/99scripts.hook"
    local cmd_prefix=""
    if [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        $cmd_prefix rm -f "$target"
    fi
}

# --- 3. Systemd Hook ---
install_systemd_hook() {
    local scope="${1:-user}"
    local target_home
    target_home="$(get_target_home)"

    if [ "$scope" = "system" ]; then
        if [ "$EUID" -ne 0 ]; then
            sudo -v || { log_err "Sudo authorization failed."; return 1; }
        fi
        local s_dir="/etc/systemd/system"
        local cmd_prefix=""
        [ "$EUID" -ne 0 ] && cmd_prefix="sudo"

        $cmd_prefix mkdir -p "$s_dir"
        $cmd_prefix tee "$s_dir/scripts-update.service" >/dev/null << 'EOF'
[Unit]
Description=Automated update for nada.mu personal utilities
Documentation=https://github.com/DanyaNADAMU/Scripts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/scripts update --scope system -y
StandardOutput=journal
StandardError=journal
EOF
        $cmd_prefix tee "$s_dir/scripts-update.timer" >/dev/null << 'EOF'
[Unit]
Description=Daily update timer for nada.mu personal utilities
Documentation=https://github.com/DanyaNADAMU/Scripts

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
EOF
        $cmd_prefix chmod 644 "$s_dir/scripts-update.service" "$s_dir/scripts-update.timer"
        if command -v systemctl >/dev/null 2>&1; then
            if $cmd_prefix systemctl daemon-reload 2>/dev/null && $cmd_prefix systemctl enable --now scripts-update.timer 2>/dev/null; then
                log_ok "Systemd system timer enabled and started (/etc/systemd/system/scripts-update.timer)."
            else
                log_ok "Systemd system unit files installed (/etc/systemd/system/scripts-update.timer)."
                log_info "Note: systemd daemon was not reachable in this session. Start it with: sudo systemctl enable --now scripts-update.timer"
            fi
        else
            log_ok "Systemd system unit files installed (/etc/systemd/system/scripts-update.timer)."
        fi
    else
        local u_dir="${target_home}/.config/systemd/user"
        mkdir -p "$u_dir"
        cat > "$u_dir/scripts-update.service" << EOF
[Unit]
Description=Automated update for nada.mu personal utilities
Documentation=https://github.com/DanyaNADAMU/Scripts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${target_home}/.local/bin/scripts update -y
StandardOutput=journal
StandardError=journal
EOF
        cat > "$u_dir/scripts-update.timer" << 'EOF'
[Unit]
Description=Daily update timer for nada.mu personal utilities
Documentation=https://github.com/DanyaNADAMU/Scripts

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
EOF
        chmod 644 "$u_dir/scripts-update.service" "$u_dir/scripts-update.timer"
        if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            chown -R "$SUDO_USER:" "$u_dir" 2>/dev/null || true
        fi
        if command -v systemctl >/dev/null 2>&1; then
            if systemctl --user daemon-reload 2>/dev/null && systemctl --user enable --now scripts-update.timer 2>/dev/null; then
                log_ok "Systemd user timer enabled and started (~/.config/systemd/user/scripts-update.timer)."
            else
                log_ok "Systemd user unit files installed (~/.config/systemd/user/scripts-update.timer)."
                log_info "Note: User systemd bus was not reachable in this session. Start it with: systemctl --user enable --now scripts-update.timer"
            fi
        else
            log_ok "Systemd user unit files installed (~/.config/systemd/user/scripts-update.timer)."
        fi
    fi
}

uninstall_systemd_hook() {
    local scope="${1:-user}"
    local target_home
    target_home="$(get_target_home)"

    if [ "$scope" = "system" ]; then
        local s_dir="/etc/systemd/system"
        local cmd_prefix=""
        [ "$EUID" -ne 0 ] && cmd_prefix="sudo"
        if command -v systemctl >/dev/null 2>&1; then
            $cmd_prefix systemctl disable --now scripts-update.timer >/dev/null 2>&1 || true
        fi
        $cmd_prefix rm -f "$s_dir/scripts-update.service" "$s_dir/scripts-update.timer"
        if command -v systemctl >/dev/null 2>&1; then
            $cmd_prefix systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        log_ok "Systemd system timer disabled."
    else
        local u_dir="${target_home}/.config/systemd/user"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user disable --now scripts-update.timer >/dev/null 2>&1 || true
        fi
        rm -f "$u_dir/scripts-update.service" "$u_dir/scripts-update.timer"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload >/dev/null 2>&1 || true
        fi
        log_ok "Systemd user timer disabled."
    fi
}

# --- 3. Shell Hook ---
SHELL_HOOK_START="# >>> nada.mu scripts autoupdate >>>"
SHELL_HOOK_END="# <<< nada.mu scripts autoupdate <<<"

install_shell_hook() {
    local target_home
    target_home="$(get_target_home)"

    local target_files=()
    [ -f "$target_home/.zshrc" ] && target_files+=("$target_home/.zshrc")
    [ -f "$target_home/.bashrc" ] && target_files+=("$target_home/.bashrc")

    if [ ${#target_files[@]} -eq 0 ]; then
        target_files+=("$target_home/.bashrc")
        touch "$target_home/.bashrc"
    fi

    local snippet
    snippet="$(cat << 'EOF'
# >>> nada.mu scripts autoupdate >>>
if [ -t 1 ] && [ -x "$HOME/.local/bin/scripts" ]; then
    _scripts_last="$HOME/.local/state/scripts/last_shell_update"
    _scripts_now=$(date +%s 2>/dev/null || echo 0)
    _scripts_prev=0
    [ -f "$_scripts_last" ] && _scripts_prev=$(stat -c %Y "$_scripts_last" 2>/dev/null || echo 0)
    if [ $((_scripts_now - _scripts_prev)) -ge 86400 ]; then
        mkdir -p "$HOME/.local/state/scripts" 2>/dev/null || true
        touch "$_scripts_last" 2>/dev/null || true
        ( "$HOME/.local/bin/scripts" update -y >/dev/null 2>&1 & ) 2>/dev/null || true
    fi
    unset _scripts_last _scripts_now _scripts_prev
fi
# <<< nada.mu scripts autoupdate <<<
EOF
)"

    for f in "${target_files[@]}"; do
        if grep -qF "$SHELL_HOOK_START" "$f" 2>/dev/null; then
            sed -i "/$SHELL_HOOK_START/,/$SHELL_HOOK_END/d" "$f"
        fi
        printf "\n%s\n" "$snippet" >> "$f"
        if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            chown "$SUDO_USER:" "$f" 2>/dev/null || true
        fi
        log_ok "Shell auto-update snippet installed into $f"
    done

    # Fish shell support
    if [ -f "$target_home/.config/fish/config.fish" ] || command -v fish >/dev/null 2>&1; then
        local fish_cfg="$target_home/.config/fish/config.fish"
        mkdir -p "$(dirname "$fish_cfg")"
        touch "$fish_cfg"
        local fish_snippet
        fish_snippet="$(cat << 'EOF'
# >>> nada.mu scripts autoupdate >>>
if status is-interactive; and test -x "$HOME/.local/bin/scripts"
    set -l _scripts_last "$HOME/.local/state/scripts/last_shell_update"
    set -l _scripts_now (date +%s 2>/dev/null; or echo 0)
    set -l _scripts_prev 0
    if test -f "$_scripts_last"
        set _scripts_prev (stat -c %Y "$_scripts_last" 2>/dev/null; or echo 0)
    end
    if test (math "$_scripts_now - $_scripts_prev") -ge 86400
        mkdir -p "$HOME/.local/state/scripts" 2>/dev/null
        touch "$_scripts_last" 2>/dev/null
        "$HOME/.local/bin/scripts" update -y >/dev/null 2>&1 &
    end
end
# <<< nada.mu scripts autoupdate <<<
EOF
)"
        if grep -qF "$SHELL_HOOK_START" "$fish_cfg" 2>/dev/null; then
            sed -i "/$SHELL_HOOK_START/,/$SHELL_HOOK_END/d" "$fish_cfg"
        fi
        printf "\n%s\n" "$fish_snippet" >> "$fish_cfg"
        if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            chown "$SUDO_USER:" "$fish_cfg" 2>/dev/null || true
        fi
        log_ok "Shell auto-update snippet installed into $fish_cfg"
    fi
}

uninstall_shell_hook() {
    local target_home
    target_home="$(get_target_home)"

    local target_files=("$target_home/.zshrc" "$target_home/.bashrc" "$target_home/.config/fish/config.fish")
    local removed=false
    for f in "${target_files[@]}"; do
        if [ -f "$f" ] && grep -qF "$SHELL_HOOK_START" "$f" 2>/dev/null; then
            sed -i "/$SHELL_HOOK_START/,/$SHELL_HOOK_END/d" "$f"
            log_ok "Removed shell auto-update snippet from $f"
            removed=true
        fi
    done
    if [ "$removed" = false ]; then
        log_info "No shell auto-update snippet found in ~/.bashrc, ~/.zshrc, or ~/.config/fish/config.fish."
    fi
}

# --- 4. Cron Hook ---
CRON_TAG="# nada.mu scripts autoupdate"

install_cron_hook() {
    local scope="${1:-user}"
    local target_home
    target_home="$(get_target_home)"

    if [ "$scope" = "system" ]; then
        if [ ! -d "/etc/cron.daily" ]; then
            log_err "/etc/cron.daily directory not found."
            return 1
        fi
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
            sudo -v || { log_err "Sudo authorization failed."; return 1; }
        fi
        $cmd_prefix tee "/etc/cron.daily/scripts-update" >/dev/null << 'EOF'
#!/bin/sh
# Automated daily update for nada.mu personal utilities
if [ -x /usr/local/bin/scripts ]; then
    /usr/local/bin/scripts update --scope system -y >/dev/null 2>&1
fi
EOF
        $cmd_prefix chmod 755 "/etc/cron.daily/scripts-update"
        log_ok "System daily cron job installed at /etc/cron.daily/scripts-update"
    else
        if ! command -v crontab >/dev/null 2>&1; then
            log_err "crontab command not found on this system."
            return 1
        fi
        local crontab_cmd="crontab"
        if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            crontab_cmd="crontab -u $SUDO_USER"
        fi
        local current_cron
        current_cron="$($crontab_cmd -l 2>/dev/null || true)"
        local filtered_cron
        filtered_cron="$(echo "$current_cron" | grep -v "$CRON_TAG" || true)"
        local new_entry="0 3 * * * ${target_home}/.local/bin/scripts update -y >/dev/null 2>&1 $CRON_TAG"
        if [ -n "$(echo "$filtered_cron" | tr -d '[:space:]')" ]; then
            printf "%s\n%s\n" "$filtered_cron" "$new_entry" | $crontab_cmd -
        else
            printf "%s\n" "$new_entry" | $crontab_cmd -
        fi
        log_ok "User cron job registered (daily at 03:00): $new_entry"
    fi
}

uninstall_cron_hook() {
    local scope="${1:-user}"
    if [ "$scope" = "system" ]; then
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
            sudo -v || { log_err "Sudo authorization failed."; return 1; }
        fi
        if [ -f "/etc/cron.daily/scripts-update" ]; then
            $cmd_prefix rm -f "/etc/cron.daily/scripts-update"
            log_ok "Removed system cron job (/etc/cron.daily/scripts-update)."
        else
            log_info "No system cron job found at /etc/cron.daily/scripts-update."
        fi
    else
        if command -v crontab >/dev/null 2>&1; then
            local crontab_cmd="crontab"
            if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
                crontab_cmd="crontab -u $SUDO_USER"
            fi
            local current_cron
            current_cron="$($crontab_cmd -l 2>/dev/null || true)"
            if echo "$current_cron" | grep -q "$CRON_TAG"; then
                local filtered_cron
                filtered_cron="$(echo "$current_cron" | grep -v "$CRON_TAG" || true)"
                if [ -n "$(echo "$filtered_cron" | tr -d '[:space:]')" ]; then
                    echo "$filtered_cron" | $crontab_cmd -
                else
                    $crontab_cmd -r 2>/dev/null || true
                fi
                log_ok "User cron job removed."
            else
                log_info "No user cron job found."
            fi
        fi
    fi
}

# --- 5. Git Hook ---
install_git_hook() {
    if [ "$IS_LOCAL_REPO" = false ]; then
        log_err "Git hook can only be enabled inside a local git clone of scripts."
        return 1
    fi
    local git_dir="$REPO_DIR/.git"
    if [ ! -d "$git_dir" ]; then
        log_err ".git directory not found in $REPO_DIR"
        return 1
    fi
    mkdir -p "$REPO_DIR/.githooks"
    cat > "$REPO_DIR/.githooks/post-merge" << 'EOF'
#!/bin/sh
# ==============================================================================
# Git Hook: post-merge
# Description: Automatically updates symlinks and utilities after 'git pull'.
# ==============================================================================
if [ -x "./scripts" ]; then
    echo "--> [git hook] Updating nada.mu utilities in background..."
    ( ./scripts update --no-pull >/dev/null 2>&1 & )
fi
EOF
    chmod +x "$REPO_DIR/.githooks/post-merge"
    git -C "$REPO_DIR" config core.hooksPath .githooks
    log_ok "Git post-merge hook enabled in $REPO_DIR/.githooks/post-merge"
}

uninstall_git_hook() {
    if [ "$IS_LOCAL_REPO" = false ]; then
        log_err "Git hook can only be disabled inside a local git clone of scripts."
        return 1
    fi
    if [ -f "$REPO_DIR/.githooks/post-merge" ]; then
        chmod -x "$REPO_DIR/.githooks/post-merge" 2>/dev/null || rm -f "$REPO_DIR/.githooks/post-merge"
        log_ok "Git post-merge hook disabled."
    else
        log_info "Git post-merge hook is already disabled."
    fi
}

load_manifest() {
    local tmp_manifest="$1"
    acquire_source
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/manifest.txt" ]; then
        cp -f "$SOURCE_DIR/manifest.txt" "$tmp_manifest"
    else
        local base_raw
        base_raw="$(get_github_raw_url)"
        if curl -fsSL --connect-timeout 4 --max-time 15 "$base_raw/manifest.txt" -o "$tmp_manifest" 2>/dev/null && [ -s "$tmp_manifest" ]; then
            return 0
        elif [ -n "${STATE_DIR:-}" ] && [ -f "$STATE_DIR/manifest.txt" ]; then
            log_warn "Using cached manifest from $STATE_DIR/manifest.txt (network unavailable)."
            cp -f "$STATE_DIR/manifest.txt" "$tmp_manifest"
        else
            log_err "Failed to download manifest.txt from upstream repository."
            exit 1
        fi
    fi
}

# ------------------------------------------------------------------------------
# Subcommand: list
# ------------------------------------------------------------------------------
cmd_list() {
    local explicit_scope=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local scope=""
    if [ -n "$explicit_scope" ]; then
        scope="$explicit_scope"
    elif [ -f "/usr/local/bin/scripts" ] || [ -f "/var/lib/scripts/manifest.txt" ]; then
        scope="system"
    else
        scope="user"
    fi
    set_scope_paths "$scope"

    local tmp_m
    tmp_m="$(mktemp -t scripts-list.XXXXXX)"
    register_tmp "$tmp_m"
    load_manifest "$tmp_m"

    log_head "Available and Installed Scripts (Scope: $scope -> $BIN_DIR)"
    printf "  %-22s %-10s %-12s %s\n" "COMMAND" "CATEGORY" "STATUS" "DESCRIPTION"
    printf "  %-22s %-10s %-12s %s\n" "-------" "--------" "------" "-----------"

    while IFS=: read -r src_path cmd_name category desc || [ -n "$src_path" ]; do
        [[ "$src_path" =~ ^#.*$ ]] && continue
        [ -z "$src_path" ] && continue

        local status="Available"
        if [ -f "$BIN_DIR/$cmd_name" ]; then
            if [ -L "$BIN_DIR/$cmd_name" ]; then
                status="Linked"
            else
                status="Installed"
            fi
        fi

        printf "  \033[1m%-22s\033[0m %-10s %-12s %s\n" "$cmd_name" "$category" "$status" "$desc"
    done < "$tmp_m"

    rm -f "$tmp_m"
    cleanup_source
    echo ""
}

# ------------------------------------------------------------------------------
# Subcommand: sync (aliases: update, install)
# ------------------------------------------------------------------------------
cmd_sync() {
    local explicit_scope=""
    local scope=""
    local category="all"
    local auto_yes=false
    local method=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            --category) category="$2"; shift 2 ;;
            -y|--yes) auto_yes=true; shift ;;
            --update) shift ;;
            --method) method="$2"; shift 2 ;;
            --no-pull|--offline) shift ;;
            *) shift ;;
        esac
    done

    local scope_status=0
    scope="$(detect_and_resolve_scope "$explicit_scope" "$auto_yes")" || scope_status=$?
    if [ $scope_status -ne 0 ]; then
        if [ $scope_status -eq 2 ]; then
            exit 0
        else
            exit 1
        fi
    fi

    if [ -z "$method" ]; then
        if [ "$IS_LOCAL_REPO" = true ]; then
            method="link"
        else
            method="copy"
        fi
    elif [ "$method" = "link" ] && [ "$IS_LOCAL_REPO" = false ]; then
        log_warn "'--method link' is only supported when running within a local git repository clone. Using 'copy'."
        method="copy"
    fi

    check_dependencies "$category" "$auto_yes" "$scope"

    set_scope_paths "$scope"

    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        log_info "System scope requested. Sudo privileges will be used."
        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
    fi

    ensure_write_access "$BIN_DIR"
    ensure_write_access "$MAN_DIR"
    ensure_write_access "$BASH_COMP_DIR"
    ensure_write_access "$ZSH_COMP_DIR"
    ensure_write_access "$FISH_COMP_DIR"
    ensure_write_access "$STATE_DIR"

    local current_manifest
    current_manifest="$(mktemp -t scripts-manifest.XXXXXX)"
    register_tmp "$current_manifest"
    load_manifest "$current_manifest"

    local prev_manifest="$STATE_DIR/manifest.txt"
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo touch "$prev_manifest"
    else
        touch "$prev_manifest"
    fi

    log_head "Synchronizing utilities in $BIN_DIR (Category: $category, Scope: $scope)..."
    printf "  \033[1m%-22s %-10s %-12s %s\033[0m\n" "COMMAND" "CATEGORY" "STATUS" "DESCRIPTION"
    printf "  %-22s %-10s %-12s %s\n" "-------" "--------" "------" "-----------"

    local count_installed=0
    local count_updated=0
    local count_unchanged=0

    while IFS=: read -r src_path cmd_name script_cat desc || [ -n "$src_path" ]; do
        [[ "$src_path" =~ ^#.*$ ]] && continue
        [ -z "$src_path" ] && continue

        if [ "$category" != "all" ] && [ "$category" != "$script_cat" ]; then
            continue
        fi

        local target_bin="$BIN_DIR/$cmd_name"
        local old_sha
        old_sha="$(get_sha256 "$target_bin")"

        # Install script
        if [ -n "$SOURCE_DIR" ]; then
            safe_copy_or_link "$SOURCE_DIR/$src_path" "$target_bin" "$method" "$NEED_SUDO"
        else
            local tmp_dl
            tmp_dl="$(mktemp -t scripts-dl.XXXXXX)"
            register_tmp "$tmp_dl"
            fetch_file "$src_path" "$tmp_dl"
            if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                sudo cp --remove-destination -f "$tmp_dl" "$target_bin" 2>/dev/null || sudo cp -f "$tmp_dl" "$target_bin"
                sudo chmod 755 "$target_bin"
            else
                cp --remove-destination -f "$tmp_dl" "$target_bin" 2>/dev/null || cp -f "$tmp_dl" "$target_bin"
                chmod 755 "$target_bin"
            fi
            rm -f "$tmp_dl"
        fi

        local new_sha
        new_sha="$(get_sha256 "$target_bin")"
        local item_status="Up to date"

        if [ -z "$old_sha" ]; then
            item_status="Installed"
            count_installed=$((count_installed + 1))
        elif [ "$old_sha" != "$new_sha" ]; then
            item_status="Updated"
            count_updated=$((count_updated + 1))
        else
            count_unchanged=$((count_unchanged + 1))
        fi

        printf "  \033[1m%-22s\033[0m %-10s %-12s %s\n" "$cmd_name" "$script_cat" "$item_status" "$desc"

        # Install Man Page & Shell Completions
        install_man_and_completions "$cmd_name"
    done < "$current_manifest"

    # Install the 'scripts' manager itself into the target bin directory
    local scripts_bin="$BIN_DIR/scripts"
    local old_scripts_sha
    old_scripts_sha="$(get_sha256 "$scripts_bin")"

    if [ -n "$SOURCE_DIR" ]; then
        if [ "$IS_LOCAL_REPO" = true ]; then
            safe_copy_or_link "$SELF_PATH" "$scripts_bin" "$method" "$NEED_SUDO"
        else
            safe_copy_or_link "$SOURCE_DIR/scripts" "$scripts_bin" "copy" "$NEED_SUDO"
        fi
    else
        local tmp_self
        tmp_self="$(mktemp -t scripts-self.XXXXXX)"
        register_tmp "$tmp_self"
        fetch_file "scripts" "$tmp_self"
        local tmp_dest="${scripts_bin}.tmp.$$"
        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo cp -f "$tmp_self" "$tmp_dest"
            sudo chmod 755 "$tmp_dest"
            sudo mv -f "$tmp_dest" "$scripts_bin"
        else
            cp -f "$tmp_self" "$tmp_dest"
            chmod 755 "$tmp_dest"
            mv -f "$tmp_dest" "$scripts_bin"
        fi
        rm -f "$tmp_self"
    fi
    install_man_and_completions "scripts"

    # In system scope, ensure /usr/bin/scripts symlinks to /usr/local/bin/scripts
    # This solves the Debian/Ubuntu/Kali sudo secure_path restriction where /usr/local/bin is excluded.
    if [ "$scope" = "system" ] && [ "$BIN_DIR" = "/usr/local/bin" ]; then
        local sys_symlink="/usr/bin/scripts"
        if [ -L "$sys_symlink" ] || [ ! -e "$sys_symlink" ]; then
            if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                sudo ln -sf "$scripts_bin" "$sys_symlink" 2>/dev/null || true
            else
                ln -sf "$scripts_bin" "$sys_symlink" 2>/dev/null || true
            fi
        fi
    fi

    local new_scripts_sha
    new_scripts_sha="$(get_sha256 "$scripts_bin")"
    local scripts_status="Up to date"
    if [ -z "$old_scripts_sha" ]; then
        scripts_status="Installed"
        count_installed=$((count_installed + 1))
    elif [ "$old_scripts_sha" != "$new_scripts_sha" ]; then
        scripts_status="Updated"
        count_updated=$((count_updated + 1))
    else
        count_unchanged=$((count_unchanged + 1))
    fi
    printf "  \033[1m%-22s\033[0m %-10s %-12s %s\n" "scripts" "manager" "$scripts_status" "Unified manager for the nada.mu personal utilities ecosystem"

    # Check for Orphaned/Deprecated scripts
    local deprecated_to_check=()
    if [ -f "$prev_manifest" ]; then
        while IFS=: read -r p_src p_cmd p_cat p_desc || [ -n "$p_src" ]; do
            [[ "$p_src" =~ ^#.*$ ]] && continue
            [ -z "$p_src" ] && continue

            if ! grep -q ":$p_cmd:" "$current_manifest"; then
                deprecated_to_check+=("$p_cmd")
            fi
        done < "$prev_manifest"
    fi

    local seen_dep=()
    for p_cmd in "${deprecated_to_check[@]}"; do
        local already=false
        for s in "${seen_dep[@]}"; do
            if [ "$s" = "$p_cmd" ]; then
                already=true
                break
            fi
        done
        [ "$already" = true ] && continue
        seen_dep+=("$p_cmd")

        if [ -f "$BIN_DIR/$p_cmd" ] || [ -L "$BIN_DIR/$p_cmd" ] || [ -f "$MAN_DIR/${p_cmd}.1" ]; then
            log_warn "Deprecated utility detected: '$p_cmd' (removed from upstream repository)."
            local del_reply="y"
            if [ "$auto_yes" = false ]; then
                read_input "Remove $BIN_DIR/$p_cmd and associated assets? (y/n)" "y" del_reply
            fi
            if [[ "$del_reply" =~ ^[Yy]$ ]]; then
                if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                    sudo rm -f "$BIN_DIR/$p_cmd"
                else
                    rm -f "$BIN_DIR/$p_cmd"
                fi
                uninstall_man_and_completions "$p_cmd"
                log_ok "Removed deprecated: $p_cmd"
            fi
        fi
    done

    # Fix ownership if running under sudo for user scope
    if [ "$scope" = "user" ] && [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        local user_grp
        user_grp="$(id -gn "$SUDO_USER" 2>/dev/null || echo "$SUDO_USER")"
        chown -R "$SUDO_USER:$user_grp" "$BIN_DIR" "$STATE_DIR" "${MAN_DIR%/*}" "${BASH_COMP_DIR%/*}" "${ZSH_COMP_DIR%/*}" 2>/dev/null || true
    fi

    # Save state manifest
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo cp -f "$current_manifest" "$prev_manifest"
    else
        cp -f "$current_manifest" "$prev_manifest"
    fi
    rm -f "$current_manifest"
    cleanup_source

    # Install APT hook if system scope and APT is present
    if [ "$scope" = "system" ] && [ -d "/etc/apt/apt.conf.d" ]; then
        install_apt_hook
    fi

    # Install Pacman hook if system scope and pacman is present
    if [ "$scope" = "system" ] && ([ -d "/etc/pacman.d" ] || command -v pacman >/dev/null 2>&1); then
        install_pacman_hook
    fi

    # Configure git hooks in local repository clones
    if [ "$IS_LOCAL_REPO" = true ]; then
        git -C "$REPO_DIR" config core.hooksPath .githooks 2>/dev/null || true
        [ -f "$REPO_DIR/.githooks/post-merge" ] && chmod +x "$REPO_DIR/.githooks/post-merge" 2>/dev/null || true
    fi

    # Synchronize Nautilus context menu scripts if desktop category is active
    if [ "$category" = "all" ] || [ "$category" = "desktop" ]; then
        sync_nautilus_scripts "$scope" "$method"
    fi

    log_head "Summary"
    echo "  Installed: $count_installed | Updated: $count_updated | Up to date: $count_unchanged"
    echo "  Binary Path: $BIN_DIR"

    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warn "$BIN_DIR is NOT currently in your PATH environment variable."
        echo "  Add it to your shell profile (~/.zshrc or ~/.bashrc):"
        echo "    export PATH=\"$BIN_DIR:\$PATH\""
    else
        log_ok "PATH check passed ($BIN_DIR is active)."
    fi

    if [ "$scope" = "system" ] && [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
        log_ok "APT hook: Auto-update enabled (/etc/apt/apt.conf.d/99scripts)."
    fi
    if [ "$scope" = "system" ]; then
        if [ -f "/usr/share/libalpm/hooks/99scripts.hook" ]; then
            log_ok "Pacman hook: Auto-update enabled (/usr/share/libalpm/hooks/99scripts.hook)."
        elif [ -f "/etc/pacman.d/hooks/99scripts.hook" ]; then
            log_ok "Pacman hook: Auto-update enabled (/etc/pacman.d/hooks/99scripts.hook)."
        fi
    fi

    if [ "$scope" = "user" ]; then
        echo "  [i] Note for Zsh completions in User scope: ensure $ZSH_COMP_DIR is in fpath in ~/.zshrc:"
        echo "      fpath=($ZSH_COMP_DIR \$fpath)"
    fi
    echo "  [i] All utilities synchronized. For category filtering, use: scripts update --category <server|desktop|media>"
    echo "  [i] Run 'scripts doctor' to inspect dependencies and environment health."
    echo ""
}

cmd_install() { cmd_sync "$@"; }
cmd_update()  { cmd_sync "$@"; }

