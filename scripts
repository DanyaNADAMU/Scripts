    cat << EOF
Usage: scripts uninstall [OPTIONS] [UTILITY...]

Remove installed utilities, man pages, shell completions, and metadata.

Arguments:
  UTILITY...           Specific utility name(s) to uninstall (e.g. media, backup-seadrive, keylight).
                       If omitted, prompts to uninstall all managed utilities.

Options:
  --scope SCOPE        Target scope: 'user' (~/.local/bin) or 'system' (/usr/local/bin)
  -y, --yes            Skip confirmation prompt
  -h, --help           Show this help message

Examples:
  scripts uninstall media                    # Remove specific utility and its assets
  scripts uninstall                          # Complete uninstallation of all utilities
  scripts uninstall -y                       # Non-interactive complete uninstallation
EOF
}

show_prune_help() {
    cat << EOF
Usage: scripts prune [OPTIONS]

Scan for and remove deprecated or orphaned utilities, man pages, and completions.

Aliases:
  scripts clean

Options:
  --scope SCOPE        Target scope: 'user' (~/.local/bin) or 'system' (/usr/local/bin)
  -y, --yes            Skip confirmation prompt
  -h, --help           Show this help message

Examples:
  scripts prune        # Scan and interactively remove orphaned utilities
  scripts prune -y     # Non-interactive prune
EOF
}

# ------------------------------------------------------------------------------
# Subcommand: prune (alias: clean)
# ------------------------------------------------------------------------------
cmd_prune() {
    local explicit_scope=""
    local auto_yes=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            -y|--yes) auto_yes=true; shift ;;
            -h|--help)
                show_prune_help
                exit 0
                ;;
            *) shift ;;
        esac
    done

    local scope_status=0
    local scope=""
    scope="$(detect_and_resolve_scope "$explicit_scope" "$auto_yes")" || scope_status=$?
    if [ $scope_status -ne 0 ]; then
        if [ $scope_status -eq 2 ]; then
            exit 0
        else
            exit 1
        fi
    fi

    set_scope_paths "$scope"
    local manifest_file="$STATE_DIR/manifest.txt"

    local tmp_manifest
    tmp_manifest="$(mktemp -t scripts-prune.XXXXXX)"
    register_tmp "$tmp_manifest"
    load_manifest "$tmp_manifest"

    local candidates=()

    # Inspect local state manifest for any tools no longer in upstream manifest
    if [ -f "$manifest_file" ]; then
        while IFS=: read -r p_src p_cmd p_cat p_desc || [ -n "$p_src" ]; do
            [[ "$p_src" =~ ^#.*$ ]] && continue
            [ -z "$p_src" ] && continue
            if ! grep -q ":$p_cmd:" "$tmp_manifest"; then
                candidates+=("$p_cmd")
            fi
        done < "$manifest_file"
    fi

    # Deduplicate candidates
    local unique_candidates=()
    for c in "${candidates[@]}"; do
        local already=false
        for u in "${unique_candidates[@]}"; do
            if [ "$u" = "$c" ]; then
                already=true
                break
            fi
        done
        if [ "$already" = false ]; then
            unique_candidates+=("$c")
        fi
    done

    # Check which candidates exist on the system
    local to_prune=()
    for c in "${unique_candidates[@]}"; do
        if [ -f "$BIN_DIR/$c" ] || [ -L "$BIN_DIR/$c" ] || [ -f "$MAN_DIR/${c}.1" ] || [ -f "$BASH_COMP_DIR/$c" ] || [ -f "$ZSH_COMP_DIR/_$c" ]; then
            to_prune+=("$c")
        fi
    done

    rm -f "$tmp_manifest"
    cleanup_source

    if [ ${#to_prune[@]} -eq 0 ]; then
        log_head "Pruning Deprecated Utilities ($BIN_DIR)"
        log_ok "No deprecated or orphaned utilities detected. Environment is clean."
        return 0
    fi

    log_head "Deprecated / Orphaned Utilities Detected in $BIN_DIR:"
    for item in "${to_prune[@]}"; do
        local details=()
        [ -e "$BIN_DIR/$item" ] && details+=("binary")
        [ -e "$MAN_DIR/${item}.1" ] && details+=("man page")
        [ -e "$BASH_COMP_DIR/$item" ] && details+=("bash completion")
        [ -e "$ZSH_COMP_DIR/_$item" ] && details+=("zsh completion")
        echo -e "  \033[1;33m[!]\033[0m \033[1m$item\033[0m (${details[*]:-unknown})"
    done
    echo ""

    if [ "$auto_yes" = false ]; then
        local reply="y"
        read_input "Remove the deprecated utilities and all associated assets? (y/n)" "y" reply
        if [[ ! "$reply" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            return 0
        fi
    fi

    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
    fi

    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    for item in "${to_prune[@]}"; do
        $cmd_prefix rm -f "$BIN_DIR/$item"
        uninstall_man_and_completions "$item"
        if [ -f "$manifest_file" ] && grep -q ":$item:" "$manifest_file" 2>/dev/null; then
            local tmp_m
            tmp_m="$(mktemp -t scripts-prune-m.XXXXXX)"
            register_tmp "$tmp_m"
            grep -v ":$item:" "$manifest_file" > "$tmp_m" || true
            $cmd_prefix cp -f "$tmp_m" "$manifest_file"
            rm -f "$tmp_m"
        fi
        log_ok "Pruned: $item"
    done

    log_ok "Cleanup complete. All deprecated utilities and assets have been removed."
}

# ------------------------------------------------------------------------------
# Subcommand: uninstall
# ------------------------------------------------------------------------------
cmd_uninstall() {
    local explicit_scope=""
    local auto_yes=false
    local targets=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            -y|--yes) auto_yes=true; shift ;;
            -h|--help)
                show_uninstall_help
                exit 0
                ;;
            -*)
                log_err "Unknown option: $1"
                show_uninstall_help
                exit 1
                ;;
            *)
                targets+=("$1")
                shift
                ;;
        esac
    done

    local scope_status=0
    local scope=""
    scope="$(detect_and_resolve_scope "$explicit_scope" "$auto_yes")" || scope_status=$?
    if [ $scope_status -ne 0 ]; then
        if [ $scope_status -eq 2 ]; then
            exit 0
        else
            exit 1
        fi
    fi

    set_scope_paths "$scope"
    local manifest_file="$STATE_DIR/manifest.txt"

    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
    fi

    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    # Targeted uninstallation of specified utilities
    if [ ${#targets[@]} -gt 0 ]; then
        log_head "Uninstalling specified utilities from $BIN_DIR..."
        if [ "$auto_yes" = false ]; then
            local confirm="y"
            read_input "Remove selected utility(ies) (${targets[*]}) from $BIN_DIR? (y/n)" "y" confirm
            if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
                echo "Aborted."
                exit 0
            fi
        fi

        for t in "${targets[@]}"; do
            local found=false
            if [ -f "$BIN_DIR/$t" ] || [ -L "$BIN_DIR/$t" ]; then
                $cmd_prefix rm -f "$BIN_DIR/$t"
                found=true
            fi
            if [ -f "$MAN_DIR/${t}.1" ] || [ -f "$BASH_COMP_DIR/$t" ] || [ -f "$ZSH_COMP_DIR/_$t" ]; then
                found=true
            fi
            uninstall_man_and_completions "$t"

            if [ -f "$manifest_file" ] && grep -q ":$t:" "$manifest_file" 2>/dev/null; then
                local tmp_m
                tmp_m="$(mktemp -t scripts-uninst-m.XXXXXX)"
                register_tmp "$tmp_m"
                grep -v ":$t:" "$manifest_file" > "$tmp_m" || true
                $cmd_prefix cp -f "$tmp_m" "$manifest_file"
                rm -f "$tmp_m"
                found=true
            fi

            if [ "$t" = "scripts" ] && [ "$scope" = "system" ]; then
                if [ -L "/usr/bin/scripts" ]; then
                    $cmd_prefix rm -f "/usr/bin/scripts"
                fi
            fi

            if [ "$found" = true ]; then
                log_ok "Removed: $t"
            else
                log_warn "Utility '$t' was not found in $BIN_DIR or state manifest."
            fi
        done
        return 0
    fi

    # Complete uninstallation of all utilities
    if [ "$auto_yes" = false ]; then
        local confirm=""
        read_input "Are you sure you want to uninstall all scripts from $BIN_DIR? (y/n)" "n" confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    log_head "Uninstalling all utilities from $BIN_DIR..."

    if [ -f "$manifest_file" ]; then
        while IFS=: read -r src_path cmd_name cat desc || [ -n "$src_path" ]; do
            [[ "$src_path" =~ ^#.*$ ]] && continue
            [ -z "$src_path" ] && continue

            $cmd_prefix rm -f "$BIN_DIR/$cmd_name"
            uninstall_man_and_completions "$cmd_name"
            log_ok "Removed: $cmd_name"
        done < "$manifest_file"

        $cmd_prefix rm -rf "$STATE_DIR" "$BIN_DIR/scripts"
        uninstall_man_and_completions "scripts"
        uninstall_nautilus_scripts
    else
        for tool in "setup-user" "media" "backup-seafile" "backup-seadrive" "keylight"; do
            $cmd_prefix rm -f "$BIN_DIR/$tool"
            uninstall_man_and_completions "$tool"
        done
        $cmd_prefix rm -f "$BIN_DIR/scripts"
        uninstall_man_and_completions "scripts"
    fi

    if [ "$scope" = "system" ]; then
        if [ -L "/usr/bin/scripts" ]; then
            $cmd_prefix rm -f "/usr/bin/scripts"
        fi
        uninstall_apt_hook
        uninstall_pacman_hook
        uninstall_systemd_hook "system"
        uninstall_cron_hook "system"
        log_ok "Removed system auto-update hooks (APT, Pacman, Systemd, Cron)"
    else
        uninstall_systemd_hook "user"
        uninstall_shell_hook
        uninstall_cron_hook "user"
        log_ok "Removed user auto-update hooks (Systemd, Shell, Cron)"
    fi

    log_ok "Uninstallation complete."
}

# ------------------------------------------------------------------------------
# Subcommand: autoupdate
# ------------------------------------------------------------------------------
cmd_autoupdate() {
    local subcmd="${1:-status}"
    [ $# -gt 0 ] && shift || true

    case "$subcmd" in
        apt|pacman)
            # Internal hook invoked by APT Post-Invoke or Pacman PostTransaction (silent background execution)
            local mgr="$subcmd"
            local stamp_file="/var/lib/scripts/last_${mgr}_update"
            local log_file="/var/log/scripts-autoupdate.log"
            local lock_file="/run/lock/scripts-${mgr}.lock"
            local now
            now="$(date +%s)"

            if [ -f "$stamp_file" ]; then
                local last
                last="$(stat -c %Y "$stamp_file" 2>/dev/null || echo 0)"
                # 24 hours rate-limit (86400 seconds)
                if [ $((now - last)) -lt 86400 ]; then
                    exit 0
                fi
            fi

            mkdir -p "/var/lib/scripts" 2>/dev/null || true
            touch "$stamp_file" 2>/dev/null || true

            # Non-blocking lock to avoid overlapping runs
            if command -v flock >/dev/null 2>&1; then
                exec 9>"$lock_file" 2>/dev/null || true
                if ! flock -n 9 2>/dev/null; then
                    exit 0
                fi
            fi

            mkdir -p "$(dirname "$log_file")" 2>/dev/null || true
            {
                echo "=== [$(date -u '+%Y-%m-%dT%H:%M:%SZ')] ${mgr^^} Auto-Update Triggered ==="
                cmd_sync --scope system -y
            } >> "$log_file" 2>&1 || true
            exit 0
            ;;
        status)
            log_head "Automated Update Mechanisms Status"
            printf "  \033[1m%-12s %-8s %-12s %s\033[0m\n" "MECHANISM" "SCOPE" "STATUS" "DETAILS"
            printf "  %-12s %-8s %-12s %s\n" "---------" "-----" "------" "-------"

            local target_home
            target_home="$(get_target_home)"

            # 1. Systemd User
            local sys_user_stat="Disabled"
            local sys_user_detail="~/.config/systemd/user/scripts-update.timer not found"
            if [ -f "$target_home/.config/systemd/user/scripts-update.timer" ]; then
                sys_user_stat="Enabled"
                sys_user_detail="Timer configured (daily, persistent)"
            elif ! command -v systemctl >/dev/null 2>&1; then
                sys_user_stat="N/A"
                sys_user_detail="systemctl command not found"
            fi
            printf "  %-12s %-8s %-12s %s\n" "systemd" "user" "$sys_user_stat" "$sys_user_detail"

            # 2. Systemd System
            local sys_sys_stat="Disabled"
            local sys_sys_detail="/etc/systemd/system/scripts-update.timer not found"
            if [ -f "/etc/systemd/system/scripts-update.timer" ]; then
                sys_sys_stat="Enabled"
                sys_sys_detail="Timer configured (daily, persistent)"
            elif ! command -v systemctl >/dev/null 2>&1; then
                sys_sys_stat="N/A"
                sys_sys_detail="systemctl command not found"
            fi
            printf "  %-12s %-8s %-12s %s\n" "systemd" "system" "$sys_sys_stat" "$sys_sys_detail"

            # 3. Shell Hook
            local sh_stat="Disabled"
            local sh_detail="No hook found in ~/.bashrc, ~/.zshrc, or ~/.config/fish/config.fish"
            local sh_found=()
            [ -f "$target_home/.bashrc" ] && grep -qF "$SHELL_HOOK_START" "$target_home/.bashrc" 2>/dev/null && sh_found+=("~/.bashrc")
            [ -f "$target_home/.zshrc" ] && grep -qF "$SHELL_HOOK_START" "$target_home/.zshrc" 2>/dev/null && sh_found+=("~/.zshrc")
            [ -f "$target_home/.config/fish/config.fish" ] && grep -qF "$SHELL_HOOK_START" "$target_home/.config/fish/config.fish" 2>/dev/null && sh_found+=("~/.config/fish/config.fish")
            if [ ${#sh_found[@]} -gt 0 ]; then
                sh_stat="Enabled"
                sh_detail="Active in $(IFS=, ; echo "${sh_found[*]}") (24h silent background)"
            fi
            printf "  %-12s %-8s %-12s %s\n" "shell" "user" "$sh_stat" "$sh_detail"

            # 4. Cron User
            local cron_u_stat="Disabled"
            local cron_u_detail="No crontab entry found"
            if command -v crontab >/dev/null 2>&1; then
                local crontab_cmd="crontab"
                if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
                    crontab_cmd="crontab -u $SUDO_USER"
                fi
                if $crontab_cmd -l 2>/dev/null | grep -q "$CRON_TAG"; then
                    cron_u_stat="Enabled"
                    cron_u_detail="Daily crontab job at 03:00"
                fi
            else
                cron_u_stat="N/A"
                cron_u_detail="crontab command not found"
            fi
            printf "  %-12s %-8s %-12s %s\n" "cron" "user" "$cron_u_stat" "$cron_u_detail"

            # 5. Cron System
            local cron_s_stat="Disabled"
            local cron_s_detail="/etc/cron.daily/scripts-update not found"
            if [ -f "/etc/cron.daily/scripts-update" ]; then
                cron_s_stat="Enabled"
                cron_s_detail="Daily job in /etc/cron.daily/scripts-update"
            elif [ ! -d "/etc/cron.daily" ]; then
                cron_s_stat="N/A"
                cron_s_detail="/etc/cron.daily directory not found"
            fi
            printf "  %-12s %-8s %-12s %s\n" "cron" "system" "$cron_s_stat" "$cron_s_detail"

            # 6. APT Hook
            local apt_stat="Disabled"
            local apt_detail="/etc/apt/apt.conf.d/99scripts not found"
            if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
                apt_stat="Enabled"
                apt_detail="/etc/apt/apt.conf.d/99scripts (non-blocking, 24h)"
            elif [ ! -d "/etc/apt/apt.conf.d" ]; then
                apt_stat="N/A"
                apt_detail="APT package manager not detected"
            fi
            printf "  %-12s %-8s %-12s %s\n" "apt" "system" "$apt_stat" "$apt_detail"

            # 7. Pacman Hook
            local pac_stat="Disabled"
            local pac_detail="No ALPM/Pacman hook found"
            if [ -L "/etc/pacman.d/hooks/99scripts.hook" ] && [ "$(readlink "/etc/pacman.d/hooks/99scripts.hook")" = "/dev/null" ]; then
                pac_stat="Disabled"
                pac_detail="/etc/pacman.d/hooks/99scripts.hook -> /dev/null (masked by admin)"
            elif [ -f "/usr/share/libalpm/hooks/99scripts.hook" ]; then
                pac_stat="Enabled"
                pac_detail="/usr/share/libalpm/hooks/99scripts.hook (system package, 24h)"
            elif [ -f "/etc/pacman.d/hooks/99scripts.hook" ]; then
                pac_stat="Enabled"
                pac_detail="/etc/pacman.d/hooks/99scripts.hook (admin hook, 24h)"
            elif [ ! -d "/etc/pacman.d" ] && [ ! -d "/usr/share/libalpm/hooks" ] && ! command -v pacman >/dev/null 2>&1; then
                pac_stat="N/A"
                pac_detail="Pacman package manager not detected"
            fi
            printf "  %-12s %-8s %-12s %s\n" "pacman" "system" "$pac_stat" "$pac_detail"

            # 8. Git Hook
            local git_stat="N/A"
            local git_detail="Only applicable within a cloned git repository"
            if [ "$IS_LOCAL_REPO" = true ]; then
                if [ -x "$REPO_DIR/.githooks/post-merge" ]; then
                    git_stat="Enabled"
                    git_detail=".githooks/post-merge (triggers on git pull)"
                else
                    git_stat="Disabled"
                    git_detail=".githooks/post-merge not installed or not executable"
                fi
            fi
            printf "  %-12s %-8s %-12s %s\n" "git" "repo" "$git_stat" "$git_detail"

            echo ""
            echo "Commands:"
            echo "  scripts autoupdate enable [systemd|shell|cron|apt|pacman|git|all] [--scope user|system]"
            echo "  scripts autoupdate disable [systemd|shell|cron|apt|pacman|git|all] [--scope user|system]"
            ;;
        enable)
            local target=""
            local explicit_scope=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --scope)
                        explicit_scope="$2"
                        shift 2
                        ;;
                    systemd|shell|cron|apt|pacman|git|all)
                        target="$1"
                        shift
                        ;;
                    *)
                        if [ -z "$target" ]; then
                            target="$1"
                        fi
                        shift
                        ;;
                esac
            done
            [ -z "$target" ] && target="all"

            local scope="$explicit_scope"
            if [ -z "$scope" ]; then
                if [ "$EUID" -eq 0 ]; then
                    scope="system"
                else
                    scope="user"
                fi
            fi

            case "$target" in
                systemd)
                    install_systemd_hook "$scope"
                    ;;
                shell)
                    install_shell_hook
                    ;;
                cron)
                    install_cron_hook "$scope"
                    ;;
                apt)
                    if [ ! -d "/etc/apt/apt.conf.d" ]; then
                        log_err "/etc/apt/apt.conf.d does not exist on this system."
                        exit 1
                    fi
                    if [ "$EUID" -ne 0 ]; then
                        log_info "Enabling APT hook requires root privileges."
                        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                    fi
                    install_apt_hook
                    log_ok "APT auto-update hook enabled at /etc/apt/apt.conf.d/99scripts."
                    ;;
                pacman)
                    if [ ! -d "/etc/pacman.d" ] && [ ! -d "/usr/share/libalpm/hooks" ] && ! command -v pacman >/dev/null 2>&1; then
                        log_err "Pacman package manager not detected on this system."
                        exit 1
                    fi
                    if [ "$EUID" -ne 0 ]; then
                        log_info "Configuring Pacman hook requires root privileges."
                        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                    fi
                    if [ -L "/etc/pacman.d/hooks/99scripts.hook" ] && [ "$(readlink "/etc/pacman.d/hooks/99scripts.hook")" = "/dev/null" ]; then
                        local cmd_prefix=""
                        [ "$EUID" -ne 0 ] && cmd_prefix="sudo"
                        $cmd_prefix rm -f "/etc/pacman.d/hooks/99scripts.hook"
                        log_ok "Pacman hook unmasked and restored."
                    elif [ -f "/usr/share/libalpm/hooks/99scripts.hook" ]; then
                        log_ok "Pacman hook is already active via system package (/usr/share/libalpm/hooks/99scripts.hook)."
                    else
                        install_pacman_hook
                        log_ok "Pacman auto-update hook enabled at /etc/pacman.d/hooks/99scripts.hook."
                    fi
                    ;;
                git)
                    install_git_hook
                    ;;
                all)
                    if [ "$scope" = "system" ]; then
                        install_systemd_hook "system" || true
                        install_cron_hook "system" || true
                        if [ -d "/etc/apt/apt.conf.d" ]; then
                            install_apt_hook || true
                        fi
                        if [ -d "/etc/pacman.d" ] || command -v pacman >/dev/null 2>&1; then
                            install_pacman_hook || true
                        fi
                    else
                        install_systemd_hook "user" || true
                        install_shell_hook || true
                        install_cron_hook "user" || true
                        if [ "$IS_LOCAL_REPO" = true ]; then
                            install_git_hook || true
                        fi
                    fi
                    log_ok "All appropriate autoupdate mechanisms enabled for scope '$scope'."
                    ;;
                *)
                    log_err "Unknown target for enable: '$target' (available: systemd, shell, cron, apt, pacman, git, all)"
                    exit 1
                    ;;
            esac
            ;;
        disable)
            local target=""
            local explicit_scope=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --scope)
                        explicit_scope="$2"
                        shift 2
                        ;;
                    systemd|shell|cron|apt|pacman|git|all)
                        target="$1"
                        shift
                        ;;
                    *)
                        if [ -z "$target" ]; then
                            target="$1"
                        fi
                        shift
                        ;;
                esac
            done
            [ -z "$target" ] && target="all"

            local scope="$explicit_scope"
            if [ -z "$scope" ]; then
                if [ "$EUID" -eq 0 ]; then
                    scope="system"
                else
                    scope="user"
                fi
            fi

            case "$target" in
                systemd)
                    uninstall_systemd_hook "$scope"
                    ;;
                shell)
                    uninstall_shell_hook
                    ;;
                cron)
                    uninstall_cron_hook "$scope"
                    ;;
                apt)
                    if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
                        if [ "$EUID" -ne 0 ]; then
                            log_info "Disabling APT hook requires root privileges."
                            sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                        fi
                        uninstall_apt_hook
                        log_ok "APT auto-update hook disabled (/etc/apt/apt.conf.d/99scripts removed)."
                    else
                        log_info "APT auto-update hook is already disabled."
                    fi
                    ;;
                pacman)
                    if [ "$EUID" -ne 0 ]; then
                        log_info "Disabling Pacman hook requires root privileges."
                        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                    fi
                    if [ -L "/etc/pacman.d/hooks/99scripts.hook" ] && [ "$(readlink "/etc/pacman.d/hooks/99scripts.hook")" = "/dev/null" ]; then
                        log_info "Pacman auto-update hook is already masked (/etc/pacman.d/hooks/99scripts.hook -> /dev/null)."
                    elif [ -f "/etc/pacman.d/hooks/99scripts.hook" ]; then
                        uninstall_pacman_hook
                        log_ok "Pacman auto-update hook disabled (/etc/pacman.d/hooks/99scripts.hook removed)."
                    elif [ -f "/usr/share/libalpm/hooks/99scripts.hook" ]; then
                        mask_pacman_hook
                        log_ok "Pacman system package hook masked via /etc/pacman.d/hooks/99scripts.hook -> /dev/null."
                    else
                        log_info "Pacman auto-update hook is already disabled."
                    fi
                    ;;
                git)
                    uninstall_git_hook
                    ;;
                all)
                    if [ "$scope" = "system" ]; then
                        uninstall_systemd_hook "system" || true
                        uninstall_cron_hook "system" || true
                        uninstall_apt_hook || true
                        if [ -f "/usr/share/libalpm/hooks/99scripts.hook" ]; then
                            mask_pacman_hook || true
                        else
                            uninstall_pacman_hook || true
                        fi
                    else
                        uninstall_systemd_hook "user" || true
                        uninstall_shell_hook || true
                        uninstall_cron_hook "user" || true
                        if [ "$IS_LOCAL_REPO" = true ]; then
                            uninstall_git_hook || true
                        fi
                    fi
                    log_ok "All autoupdate mechanisms disabled for scope '$scope'."
                    ;;
                *)
                    log_err "Unknown target for disable: '$target' (available: systemd, shell, cron, apt, pacman, git, all)"
                    exit 1
                    ;;
            esac
            ;;
        -h|--help|help)
            echo "Usage: scripts autoupdate [status|enable|disable] [systemd|shell|cron|apt|pacman|git|all] [--scope user|system]"
            echo ""
            echo "Manage automated update mechanisms across the ecosystem."
            echo ""
            echo "Targets:"
            echo "  systemd      Systemd update timer (user or system scope)"
            echo "  shell        Interactive shell startup hook (24h silent background in ~/.bashrc, ~/.zshrc, ~/.config/fish/config.fish)"
            echo "  cron         Daily cron job (user crontab or /etc/cron.daily)"
            echo "  apt          APT package manager hook (/etc/apt/apt.conf.d/99scripts)"
            echo "  pacman       Pacman / ALPM package manager hook (/etc/pacman.d/hooks/99scripts.hook)"
            echo "  git          Git post-merge hook for local repository clones"
            echo "  all          Enable or disable all mechanisms for the specified scope"
            echo ""
            echo "Options:"
            echo "  --scope SCOPE  Target scope: 'user' or 'system'"
            exit 0
            ;;
        *)
            log_err "Unknown action: '$subcmd'"
            echo "Usage: scripts autoupdate [status|enable|disable] [systemd|shell|cron|apt|git|all] [--scope user|system]"
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Subcommand: nautilus
# ------------------------------------------------------------------------------
get_nautilus_target_dir() {
    local target_home="$HOME"
    if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        target_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
    fi
    echo "${target_home}/.local/share/nautilus/scripts"
}

sync_nautilus_scripts() {
    local scope="${1:-user}"
    local method="${2:-link}"
    local is_explicit="${3:-false}"

    # In pure root system scope without a real SUDO_USER (e.g. headless server / container),
    # skip during automatic sync unless explicitly invoked via 'scripts nautilus install'
    if [ "$is_explicit" = false ] && [ "$scope" = "system" ] && [ "$EUID" -eq 0 ] && [ -z "${SUDO_USER:-}" ]; then
        return 0
    fi

    local target_nautilus_dir
    target_nautilus_dir="$(get_nautilus_target_dir)"

    local cmd_prefix=""
    if [ "$EUID" -ne 0 ] && [ ! -w "$(dirname "$target_nautilus_dir" 2>/dev/null || echo "")" ] && [ -d "$(dirname "$target_nautilus_dir" 2>/dev/null || echo "")" ]; then
        cmd_prefix="sudo"
    fi

    $cmd_prefix mkdir -p "$target_nautilus_dir"

    # Define symlink mappings: <command_binary> -> <nautilus_menu_title>
    declare -A mappings=(
        ["bisync-synced"]="BiSync All Synced"
        ["gdrive-upload"]="Copy Selected to Google Drive"
        ["bluetooth-send"]="Send to Phone via Bluetooth"
    )

    for bin_cmd in "${!mappings[@]}"; do
        local menu_title="${mappings[$bin_cmd]}"
        local dest_link="$target_nautilus_dir/$menu_title"
        local src_bin="$BIN_DIR/$bin_cmd"

        local candidate_bin=""
        if [ -x "$src_bin" ]; then
            candidate_bin="$src_bin"
        elif [ -x "/usr/bin/$bin_cmd" ]; then
            candidate_bin="/usr/bin/$bin_cmd"
        elif [ -x "/usr/local/bin/$bin_cmd" ]; then
            candidate_bin="/usr/local/bin/$bin_cmd"
        elif [ -n "${SOURCE_DIR:-}" ] && [ "$IS_LOCAL_REPO" = true ]; then
            case "$bin_cmd" in
                bisync-synced)  [ -f "$SOURCE_DIR/desktop/bisync_synced.sh" ] && candidate_bin="$SOURCE_DIR/desktop/bisync_synced.sh" ;;
                gdrive-upload)  [ -f "$SOURCE_DIR/desktop/gdrive_upload.sh" ] && candidate_bin="$SOURCE_DIR/desktop/gdrive_upload.sh" ;;
                bluetooth-send) [ -f "$SOURCE_DIR/desktop/bluetooth_send.sh" ] && candidate_bin="$SOURCE_DIR/desktop/bluetooth_send.sh" ;;
            esac
        fi

        if [ -n "$candidate_bin" ]; then
            $cmd_prefix rm -f "$dest_link"
            $cmd_prefix ln -sf "$candidate_bin" "$dest_link"
        fi
    done

    # Remove obsolete or legacy script names if they linger
    $cmd_prefix rm -f "$target_nautilus_dir/Send to Danya phone via Bluetooth" 2>/dev/null || true
    $cmd_prefix rm -f "$target_nautilus_dir/bisync-all-synced" 2>/dev/null || true

    # Fix ownership if running under sudo for user profile
    if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
        local user_grp
        user_grp="$(id -gn "$SUDO_USER" 2>/dev/null || echo "$SUDO_USER")"
        chown -R "$SUDO_USER:$user_grp" "$target_nautilus_dir" 2>/dev/null || true
    fi

    log_ok "Nautilus context scripts synchronized -> $target_nautilus_dir"
}

uninstall_nautilus_scripts() {
    local target_nautilus_dir
    target_nautilus_dir="$(get_nautilus_target_dir)"
    if [ ! -d "$target_nautilus_dir" ]; then
        log_info "No Nautilus scripts directory found at $target_nautilus_dir"
        return 0
    fi

    local cmd_prefix=""
    if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
        cmd_prefix=""
    elif [ "$EUID" -ne 0 ] && [ ! -w "$target_nautilus_dir" ]; then
        cmd_prefix="sudo"
    fi

    $cmd_prefix rm -f "$target_nautilus_dir/BiSync All Synced" \
                      "$target_nautilus_dir/Copy Selected to Google Drive" \
                      "$target_nautilus_dir/Send to Phone via Bluetooth" \
                      "$target_nautilus_dir/Send to Danya phone via Bluetooth" 2>/dev/null || true

    log_ok "Removed scripts from $target_nautilus_dir"
}

cmd_nautilus() {
    local action="${1:-list}"
    [ $# -gt 0 ] && shift || true

    case "$action" in
        install|sync)
            local explicit_scope=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --scope) explicit_scope="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local scope="user"
            if [ -n "$explicit_scope" ]; then
                scope="$explicit_scope"
            elif [ "$EUID" -eq 0 ]; then
                scope="system"
            fi
            set_scope_paths "$scope"
            sync_nautilus_scripts "$scope" "link" true
            ;;
        uninstall|remove)
            uninstall_nautilus_scripts
            ;;
        list|status)
            local target_nautilus_dir
            target_nautilus_dir="$(get_nautilus_target_dir)"
            log_head "Nautilus Context Scripts ($target_nautilus_dir)"
            if [ -d "$target_nautilus_dir" ]; then
                printf "  %-32s %-10s %s\n" "SCRIPT NAME" "TYPE" "TARGET"
                printf "  %-32s %-10s %s\n" "-----------" "----" "------"
                for item in "$target_nautilus_dir"/*; do
                    [ -e "$item" ] || [ -L "$item" ] || continue
                    local iname
                    iname="$(basename "$item")"
                    local itype="File"
                    local itarget="Local script"
                    if [ -L "$item" ]; then
                        itype="Symlink"
                        itarget="$(readlink "$item")"
                    fi
                    printf "  %-32s %-10s %s\n" "$iname" "$itype" "$itarget"
                done
            else
                log_info "Nautilus scripts directory does not exist yet. Run 'scripts nautilus install' to initialize."
            fi
            ;;
        -h|--help|help)
            cat << EOF
Usage: scripts nautilus [COMMAND]

Manage GNOME Nautilus context menu scripts (stored in ~/.local/share/nautilus/scripts).

Commands:
  install, sync     Synchronize and install context menu scripts
  list, status      List active context menu scripts and target symlinks
  uninstall, remove Remove repository scripts from the Nautilus scripts directory
  help, -h          Show this help message
EOF
            ;;
        *)
            log_err "Unknown nautilus command: '$action'"
            echo "Run 'scripts nautilus help' for usage." >&2
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Subcommand: doctor
# ------------------------------------------------------------------------------
cmd_doctor() {
    local fix_mode=false
    local explicit_scope=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --fix)      fix_mode=true; shift ;;
            --scope)    explicit_scope="$2"; shift 2 ;;
            *)          shift ;;
        esac
    done

    local scope="$explicit_scope"
    if [ -z "$scope" ]; then
        if [ "$EUID" -eq 0 ]; then
            scope="system"
        else
            scope="user"
        fi
    fi
    set_scope_paths "$scope"

    echo ""
    echo -e "\033[1;34m==>\033[0m \033[1mRunning nada.mu scripts diagnostic doctor...\033[0m"
    echo ""

    local os_name="Unknown"
    local is_arch=false
    local has_pacman=false
    local has_apt=false

    if [ -f /etc/os-release ]; then
        os_name="$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2- | tr -d '"')"
        if grep -qE '^ID(_LIKE)?=.*(arch|cachyos|manjaro|endeavouros)' /etc/os-release; then
            is_arch=true
        fi
    fi
    [ -f /etc/arch-release ] && is_arch=true
    [ -f /etc/cachyos-release ] && is_arch=true
    command -v pacman >/dev/null 2>&1 && has_pacman=true
    command -v apt-get >/dev/null 2>&1 && has_apt=true

    local current_user="${USER:-$(whoami 2>/dev/null || echo "user")}"
    local current_shell="${SHELL:-/bin/bash}"

    echo -e "  \033[1mEnvironment:\033[0m"
    echo "    OS:            $os_name ($(uname -m))"
    echo "    Kernel:        $(uname -r)"
    echo "    Shell:         $current_shell ($($current_shell --version 2>/dev/null | head -n 1 || echo ""))"
    echo "    Current User:  $current_user (EUID: $EUID)"
    echo "    Target Scope:  $BIN_DIR"
    echo ""

    echo -e "  \033[1mCore Runtime Dependencies:\033[0m"
    local core_ok=true

    # Bash
    local bash_ver
    bash_ver="$(bash --version 2>/dev/null | head -n 1 | awk '{print $4}' || echo "unknown")"
    echo -e "    [\033[1;32m✓\033[0m] bash         Found ($bash_ver)"

    # Git
    if command -v git >/dev/null 2>&1; then
        local git_ver
        git_ver="$(git --version 2>/dev/null | awk '{print $3}')"
        echo -e "    [\033[1;32m✓\033[0m] git          Found ($git_ver)"
    else
        echo -e "    [\033[1;31m✗\033[0m] git          Missing (Required for cloning and updates)"
        core_ok=false
    fi

    # systemd
    if command -v systemctl >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] systemd      Found ($(systemctl --version 2>/dev/null | head -n 1 | awk '{print $2}'))"
    else
        echo -e "    [\033[1;33m!\033[0m] systemd      Missing (Optional / systemd timers and service management unavailable)"
    fi

    # uv
    if command -v uv >/dev/null 2>&1; then
        local uv_ver uv_path
        uv_ver="$(uv --version 2>/dev/null || echo "installed")"
        uv_path="$(command -v uv)"
        echo -e "    [\033[1;32m✓\033[0m] uv           Found ($uv_ver at $uv_path)"
    else
        echo -e "    [\033[1;31m✗\033[0m] uv           Missing (Required for Python scripts: keylight, media, scan-reality)"
        core_ok=false
    fi
    echo ""

    echo -e "  \033[1mOptional Feature Dependencies:\033[0m"
    local missing_arch_pkgs=()
    local missing_apt_pkgs=()

    # rclone
    if command -v rclone >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] rclone       Found ($(rclone --version 2>/dev/null | head -n 1 | awk '{print $2}')) - Cloud backups & sync"
    else
        echo -e "    [\033[1;33m!\033[0m] rclone       Missing (Needed for: backup-seafile, backup-seadrive, bisync-synced, gdrive-upload)"
        missing_arch_pkgs+=("rclone")
        missing_apt_pkgs+=("rclone")
    fi

    # openrgb
    if command -v openrgb >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] openrgb      Found - Keyboard RGB lighting profiles (keylight)"
    else
        echo -e "    [\033[1;33m!\033[0m] openrgb      Missing (Needed for: keylight)"
        missing_arch_pkgs+=("openrgb")
    fi

    # notify-send (libnotify)
    if command -v notify-send >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] libnotify    Found - Desktop notifications (bisync-synced)"
    else
        echo -e "    [\033[1;33m!\033[0m] libnotify    Missing (Needed for: desktop notifications in bisync-synced)"
        missing_arch_pkgs+=("libnotify")
        missing_apt_pkgs+=("libnotify-bin")
    fi

    # btrfs
    if command -v btrfs >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] btrfs-progs  Found - Snapshot protection (bisync-synced)"
    else
        echo -e "    [\033[1;33m!\033[0m] btrfs-progs  Missing (Needed for: Btrfs snapshot safety in bisync-synced)"
        missing_arch_pkgs+=("btrfs-progs")
        missing_apt_pkgs+=("btrfs-progs")
    fi

    # blueman-sendto
    if command -v blueman-sendto >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] blueman      Found - Bluetooth file transfer (bluetooth-send)"
    else
        echo -e "    [\033[1;33m!\033[0m] blueman      Missing (Needed for: bluetooth-send)"
        missing_arch_pkgs+=("blueman")
        missing_apt_pkgs+=("blueman")
    fi

    # nautilus
    if command -v nautilus >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] nautilus     Found - GNOME Files context menu actions"
    else
        echo -e "    [\033[1;33m!\033[0m] nautilus     Missing (Optional: nautilus file manager scripts)"
    fi

    # sshfs
    if command -v sshfs >/dev/null 2>&1; then
        echo -e "    [\033[1;32m✓\033[0m] sshfs        Found - SSHFS filesystem mounts"
    else
        echo -e "    [\033[1;33m!\033[0m] sshfs        Missing (Optional: sshfs shim)"
        missing_arch_pkgs+=("sshfs")
        missing_apt_pkgs+=("sshfs")
    fi
    echo ""

    echo -e "  \033[1mEnvironment & PATH Health:\033[0m"
    local bin_in_path=false
    if [[ ":$PATH:" == *":$BIN_DIR:"* ]]; then
        bin_in_path=true
        echo -e "    [\033[1;32m✓\033[0m] Target BIN_DIR is active in \$PATH ($BIN_DIR)"
    else
        echo -e "    [\033[1;31m✗\033[0m] Target BIN_DIR is NOT in \$PATH ($BIN_DIR)"
        echo "        Add to your shell profile (~/.zshrc or ~/.bashrc):"
        echo "        export PATH=\"$BIN_DIR:\$PATH\""
    fi

    [ -d "$BASH_COMP_DIR" ] && echo -e "    [\033[1;32m✓\033[0m] Bash completion directory exists ($BASH_COMP_DIR)" || echo -e "    [\033[1;33m!\033[0m] Bash completion directory not created yet"
    [ -d "$ZSH_COMP_DIR" ] && echo -e "    [\033[1;32m✓\033[0m] Zsh completion directory exists ($ZSH_COMP_DIR)" || echo -e "    [\033[1;33m!\033[0m] Zsh completion directory not created yet"
    [ -d "$FISH_COMP_DIR" ] && echo -e "    [\033[1;32m✓\033[0m] Fish completion directory exists ($FISH_COMP_DIR)" || echo -e "    [\033[1;33m!\033[0m] Fish completion directory not created yet"
    echo ""

    # Remediation recommendations
    if [ ${#missing_arch_pkgs[@]} -gt 0 ] && [ "$has_pacman" = true ]; then
        echo -e "\033[1;36m==>\033[0m \033[1mArch/CachyOS Package Recommendation:\033[0m"
        echo "    Install all missing optional dependencies with:"
        echo -e "    \033[1;32msudo pacman -S --needed ${missing_arch_pkgs[*]}\033[0m"
        echo ""

        if [ "$fix_mode" = true ]; then
            echo -e "\033[1;34m==>\033[0m Executing fix command now..."
            sudo pacman -S --needed "${missing_arch_pkgs[@]}"
        fi
    elif [ ${#missing_apt_pkgs[@]} -gt 0 ] && [ "$has_apt" = true ]; then
        echo -e "\033[1;36m==>\033[0m \033[1mDebian/Ubuntu Package Recommendation:\033[0m"
        echo "    Install missing optional dependencies with:"
        echo -e "    \033[1;32msudo apt update && sudo apt install -y ${missing_apt_pkgs[*]}\033[0m"
        echo ""

        if [ "$fix_mode" = true ]; then
            echo -e "\033[1;34m==>\033[0m Executing fix command now..."
            sudo apt update && sudo apt install -y "${missing_apt_pkgs[@]}"
        fi
    fi

    if [ "$core_ok" = true ] && [ "$bin_in_path" = true ] && [ ${#missing_arch_pkgs[@]} -eq 0 ] && [ ${#missing_apt_pkgs[@]} -eq 0 ]; then
        log_ok "All checks passed! System environment is healthy and fully configured."
    fi
}

# ------------------------------------------------------------------------------
# Subcommand: pkgbuild
# ------------------------------------------------------------------------------
cmd_pkgbuild() {
    local install_pkg=false
    local print_srcinfo=false
    local clean_build=false
    local local_mode=true

    for arg in "$@"; do
        case "$arg" in
            -i|--install)       install_pkg=true ;;
            -c|--clean)         clean_build=true ;;
            --printsrcinfo)     print_srcinfo=true ;;
            --remote)           local_mode=false ;;
            --local)            local_mode=true ;;
            -h|--help)
                echo "Usage: scripts pkgbuild [options]"
                echo ""
                echo "Build native Arch Linux / CachyOS package (.pkg.tar.zst) via makepkg."
                echo ""
                echo "Options:"
                echo "  -i, --install      Install package after building (pacman -U)"
                echo "  -c, --clean        Clean build directory and artifacts before/after"
                echo "  --local            Build from local working tree without git clone (default in repo)"
                echo "  --remote           Build from remote git clone (upstream main)"
                echo "  --printsrcinfo     Generate/print .SRCINFO for AUR submission"
                echo "  -h, --help         Show this help"
                return 0
                ;;
        esac
    done

    if [ "$print_srcinfo" = true ]; then
        if command -v makepkg >/dev/null 2>&1; then
            makepkg --printsrcinfo > "$SOURCE_DIR/.SRCINFO"
            log_ok "Updated .SRCINFO from PKGBUILD."
            cat "$SOURCE_DIR/.SRCINFO"
        else
            log_err "'makepkg' not found. Cannot generate .SRCINFO automatically."
            exit 1
        fi
        return 0
    fi

    if ! command -v makepkg >/dev/null 2>&1; then
        log_err "'makepkg' is required but not installed."
        log_info "Install base-devel: sudo pacman -S --needed base-devel git"
        exit 1
    fi

    local target_pkgbuild="$SOURCE_DIR/PKGBUILD"
    if [ ! -f "$target_pkgbuild" ]; then
        log_err "PKGBUILD not found in $SOURCE_DIR"
        exit 1
    fi

    log_head "Building native Arch/CachyOS package via makepkg..."
    cd "$SOURCE_DIR"

    if [ "$clean_build" = true ]; then
        rm -rf src pkg *.pkg.tar.zst
    fi

    local makepkg_args=("-f")
    if [ "$install_pkg" = true ]; then
        makepkg_args+=("-i")
    fi

    if [ "$local_mode" = true ]; then
        mkdir -p src
        ln -sfn "$SOURCE_DIR" src/scripts-git
        makepkg_args+=("-e")
    fi

    if makepkg "${makepkg_args[@]}"; then
        log_ok "Package built successfully!"
        ls -la *.pkg.tar.zst 2>/dev/null || true
    else
        log_err "makepkg build failed."
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
show_help() {
    cat << EOF
Usage: scripts [COMMAND] [OPTIONS]

Unified manager for the nada.mu personal utilities ecosystem.

Commands:
  update       Sync and update utilities with repository (default: all)
  list         List all declared utilities and their current status
  doctor       Inspect dependencies, optional tools, and environment health
  pkgbuild     Build native Arch/CachyOS package (.pkg.tar.zst) via makepkg
  prune        Remove deprecated or orphaned utilities (alias: clean)
  autoupdate   Manage automated updates (systemd, shell, cron, apt, pacman, git)
  nautilus     Manage GNOME Nautilus context menu scripts (install, list, uninstall)
  uninstall    Remove installed utilities, man pages, and completions
  help         Display this help message

Options:
  --scope SCOPE        Target scope: 'user' (~/.local/bin) or 'system' (/usr/local/bin)
  --category CAT       Filter category: 'all', 'server', 'desktop', 'media'
  --method METHOD      Installation method: 'link' (default for repo) or 'copy'
  --no-pull            Skip git pull when updating inside local git clone
  -y, --yes            Non-interactive mode; accept all defaults
  -h, --help           Show this help message

Examples:
  scripts update                          # Update all utilities (auto-scope, zero-prompt)
  scripts update --category server        # Update server utilities only
  sudo scripts update --scope system      # System-wide update in /usr/local/bin
  scripts doctor                          # Run system diagnostic checks
  scripts doctor --fix                    # Run checks and offer to install missing dependencies
  scripts pkgbuild -i                     # Build and install native Arch package locally
  scripts prune                           # Scan and clean up orphaned utilities
  scripts uninstall media                 # Remove specific utility
  scripts autoupdate status               # View automated update status across all mechanisms
  scripts autoupdate enable systemd       # Enable systemd update timer
  scripts autoupdate enable shell         # Enable terminal startup background sync
  scripts autoupdate enable all           # Enable recommended auto-update suite
  scripts list                            # View available tools and statuses
EOF
}

ACTION="${1:-}"
[ $# -gt 0 ] && shift || true

case "$ACTION" in
    sync|update|install)
        do_pull=true
        for arg in "$@"; do
            if [ "$arg" = "--no-pull" ] || [ "$arg" = "--offline" ]; then
                do_pull=false
                break
            fi
        done
        # If in local git repo, pull first if possible
        if [ "$do_pull" = true ] && [ "$IS_LOCAL_REPO" = true ] && [ -d "$REPO_DIR/.git" ]; then
            log_head "Pulling latest changes from git repository..."
            git -C "$REPO_DIR" pull --ff-only || log_warn "Git pull failed or offline; proceeding with local files."
        fi
        cmd_sync "$@"
        ;;
    doctor)
        cmd_doctor "$@"
        ;;
    pkgbuild|build-pkg)
        cmd_pkgbuild "$@"
        ;;
    prune|clean)
        cmd_prune "$@"
        ;;
    autoupdate)
        cmd_autoupdate "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    nautilus)
        cmd_nautilus "$@"
        ;;
    uninstall)
        cmd_uninstall "$@"
        ;;
    ""|-h|--help|help)
        show_help
        exit 0
        ;;
    *)
        log_err "Unknown command: '$ACTION'"
        show_help
        exit 1
        ;;
esac
