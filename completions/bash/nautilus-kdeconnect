# Bash completion for nautilus-kdeconnect
_nautilus_kdeconnect_completions() {
    local cur
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "-h --help -r --reset" -- "$cur") )
    else
        _filedir
    fi
}
complete -F _nautilus_kdeconnect_completions nautilus-kdeconnect
